# ==============================================================================
# PhotoNotes Environment Configuration
# ==============================================================================
# Copy this file to .env or /etc/photonotes.env on EC2.
# Never commit real credentials or .env files to source control.

# Set to 1 to run locally on your laptop using SQLite and ./uploads folder.
# Set to 0 or leave unset when deploying to AWS EC2 (RDS + S3).
LOCAL_MODE=0

# Amazon RDS MySQL Configuration (Required when LOCAL_MODE=0)
DB_HOST=my-mysql-cluster.cluster-xyz.us-east-1.rds.amazonaws.com
DB_USER=admin
DB_PASSWORD=ChangeMeWithStrongPassword123!
DB_NAME=photonotes

# Amazon S3 Configuration (Required when LOCAL_MODE=0)
# Note: AWS credentials are NOT specified here! The EC2 instance accesses S3
# automatically through its IAM Instance Profile role.
S3_BUCKET=my-photonotes-app-bucket-2026
AWS_REGION=us-east-1

# Optional Port (defaults to 5000 if not specified)
PORT=5000
